# Claude Bridge configuration.
# Copy this file to .env and fill in the values.  NEVER commit .env - it
# contains your GHL API key.  (.gitignore already excludes it.)

# --- Server ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3000

# Optional bearer token. When set, every /api/* call except /api/status must
# send  Authorization: Bearer <token>  (or ?token=<token>).  Leave blank while
# the bridge is localhost-only; set it before exposing the bridge over Tailscale.
BRIDGE_TOKEN=

# --- CORS ---
# Comma-separated origins allowed to call the bridge from a browser.
# Include your GitHub Pages URL once the proxy page is deployed.
ALLOWED_ORIGINS=http://localhost:3000,https://jimboky.github.io,null

# --- Obsidian ---
# Absolute path to the vault root.
OBSIDIAN_VAULT=/Users/james/Documents/ZenithPro-Memory

# --- Filesystem ---
# Comma-separated absolute roots that /api/filesystem/list may list.
# Anything outside these roots is refused. Defaults to your home directory.
FS_ALLOWED_ROOTS=/Users/james

# --- GoHighLevel ---
# v2 (LeadConnector / Private Integration token) - the modern API:
#   GHL_BASE_URL=https://services.leadconnectorhq.com
#   GHL_API_VERSION=2021-07-28
#   GHL_LOCATION_ID is auto-appended as ?locationId= when missing.
#
# v1 (legacy location API key):
#   GHL_BASE_URL=https://rest.gohighlevel.com/v1
#   GHL_API_VERSION=        (leave blank - v1 has no Version header)
#   GHL_LOCATION_ID=        (leave blank - v1 keys are location-scoped)
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_API_KEY=
GHL_LOCATION_ID=
